# 本地演示默认无需凭证。复制为 .env，配置后重启。
PORT=4317
HOST=127.0.0.1
# 千帆服务端 API Key（仅服务端读取）
QIANFAN_API_KEY=
# 填入当前账号可用的模型 ID；未填写时使用下方示例。
QIANFAN_MODEL=ernie-4.5-turbo-128k
# 百度地图浏览器类型 AK，会按 JS SDK 要求提供给浏览器。请设置域名白名单。
BAIDU_MAP_BROWSER_AK=
# 可选：设置后家庭API需要登录口令，医生分享入口仍只提供就医包快照。
APP_ACCESS_CODE=
# PDF生成/提取：默认自动检测当前桌面运行环境；其他部署可设置Python与中文TTF/TTC字体。
PDF_PYTHON=
PDF_CJK_FONT=
# 如需同一 Wi-Fi 的手机访问，将 HOST 改为 0.0.0.0。仅在可信演示网络使用。
# 中文语音：配置百度凭证后优先调用百度TTS；未配置时macOS使用本机中文合成音。
BAIDU_TTS_API_KEY=
BAIDU_TTS_SECRET_KEY=
# 推荐度沁遥=4197；度怀安=4195。需在百度控制台开通对应音库权限。
# 如只开通基础音库，可设为0。
BAIDU_TTS_SPEAKER=4197
LOCAL_TTS_VOICE=Tingting
